# Copy to .streamlit/secrets.toml in Render's Secret Files dashboard.
# Replace placeholders in the dashboard only; never commit real credentials.
[auth]
redirect_uri = "https://YOUR-RENDER-SERVICE.onrender.com/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
owner_key_secret = "REPLACE_WITH_A_SEPARATE_LONG_RANDOM_SECRET"
client_id = "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID"
client_secret = "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
